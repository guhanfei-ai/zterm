{
  "name": "zterm",
  "version": "0.3.3",
  "description": "Electron 版最小闭环终端 + AI 聊天应用",
  "main": "./out/main/index.js",
  "author": {
    "name": "zTerm contributors",
    "email": "taycc3223@gmail.com"
  },
  "license": "MIT",
  "repository": "https://github.com/guhanfei-ai/zterm.git",
  "homepage": "https://github.com/guhanfei-ai/zterm",
  "bugs": {
    "url": "https://github.com/guhanfei-ai/zterm/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "build:mac": "electron-vite build && electron-builder --mac --arm64 --publish never",
    "build:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "build:linux": "electron-vite build && electron-builder --linux --publish never",
    "verify": "npm run typecheck && npm test -- --run",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "deploy": "bash deploy.sh"
  },
  "build": {
    "appId": "com.zterm.app",
    "productName": "zTerm",
    "directories": {
      "output": "builds"
    },
    "icon": "resources/zterm-icon-v2.png",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "zterm-${version}-macos-arm64.${ext}"
    },
    "dmg": {
      "artifactName": "zterm-${version}-macos-arm64.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "zterm-${version}-windows-x64-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "artifactName": "zterm-${version}-windows-x64-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "artifactName": "zterm-${version}-linux-${arch}.${ext}"
    },
    "files": [
      "out/**/*"
    ]
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.7",
    "dompurify": "^3.4.11",
    "electron-store": "^8.2.0",
    "marked": "^18.0.5",
    "node-pty": "^1.0.0",
    "openai": "^4.80.0",
    "ssh2": "^1.16.0",
    "uuid": "^10.0.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-search": "^0.13.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/dompurify": "^3.0.5",
    "@types/ssh2": "^1.15.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^4.1.9",
    "electron": "^33.3.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "pinia": "^2.2.8",
    "typescript": "^5.6.3",
    "vitest": "^4.1.9",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "ssh2@1.17.0": true,
    "electron@33.4.11": true,
    "vue-demi@0.14.10": true,
    "cpu-features@0.0.10": true
  }
}
